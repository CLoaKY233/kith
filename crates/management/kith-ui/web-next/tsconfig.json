{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "paths": { "@kith/types": ["../web/src/lib/types.gen.ts"] }
  },
  "include": ["src"]
}
