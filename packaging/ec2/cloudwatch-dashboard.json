{"widgets": [{"type": "text", "x": 0, "y": 0, "width": 24, "height": 2, "properties": {"markdown": "## kith VPN server (vpn.plottypus.com)\nEC2 t4g.small, Mumbai. Every figure here is in the CloudWatch free tier: basic 5-minute EC2 and disk metrics, 7 of 10 free custom metrics, alarms within the free 10. **Data out** shows the total for the chosen time range; pick *1 month* to compare with the 100 GB free allowance."}}, {"type": "metric", "x": 0, "y": 2, "width": 4, "height": 4, "properties": {"title": "kith running", "metrics": [["kith", "KithUp", {"stat": "Minimum", "label": "Up (1) or down (0)"}]], "view": "singleValue", "region": "ap-south-1", "period": 300, "stacked": false}}, {"type": "metric", "x": 4, "y": 2, "width": 5, "height": 4, "properties": {"title": "Devices online", "metrics": [["kith", "PeersOnline", {"stat": "Maximum", "label": "Online"}], ["kith", "PeersTotal", {"stat": "Maximum", "label": "In the network"}]], "view": "singleValue", "region": "ap-south-1", "period": 300, "stacked": false}}, {"type": "metric", "x": 9, "y": 2, "width": 5, "height": 4, "properties": {"title": "Data out (this time range)", "metrics": [["AWS/EC2", "NetworkOut", "InstanceId", "i-05e1287f8a325ada6", {"stat": "Sum", "label": "Bytes out to the internet"}]], "view": "singleValue", "region": "ap-south-1", "period": 300, "stacked": false, "setPeriodToTimeRange": true}}, {"type": "metric", "x": 14, "y": 2, "width": 5, "height": 4, "properties": {"title": "Data in (this time range)", "metrics": [["AWS/EC2", "NetworkIn", "InstanceId", "i-05e1287f8a325ada6", {"stat": "Sum", "label": "Bytes in"}]], "view": "singleValue", "region": "ap-south-1", "period": 300, "stacked": false, "setPeriodToTimeRange": true}}, {"type": "metric", "x": 19, "y": 2, "width": 5, "height": 4, "properties": {"title": "CPU credits left", "metrics": [["AWS/EC2", "CPUCreditBalance", "InstanceId", "i-05e1287f8a325ada6", {"stat": "Average", "label": "Credits (t4g bursts while above 0)"}]], "view": "singleValue"