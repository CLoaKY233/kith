#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/kith
CONF=/etc/kith/kith.toml

start_service() {
	mkdir -p /var/lib/kith /var/run/kith
	chmod 700 /var/lib/kith
	procd_open_instance
	procd_set_param command "$PROG" daemon --config "$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65536 65536"
	procd_close_instance
}
