[Unit]
Description=kith Console (kith-ui in public mode)
Wants=network-online.target
After=network-online.target kith.service

[Service]
Type=simple
# install.sh writes KITH_CONSOLE_DOMAIN (and optionally KITH_CONSOLE_EMAIL) here.
EnvironmentFile=/etc/kith/console.env
ExecStart=/usr/local/bin/kith-ui --public ${KITH_CONSOLE_DOMAIN}
Restart=on-failure
RestartSec=2s
# Its own system user (install.sh creates it); the kith group lets it use the daemon's
# socket. Not DynamicUser: kith looks the group up in /etc/group, where dynamic users never
# appear, and would treat the Console as a member that can only read.
User=kith-console
Group=kith-console
SupplementaryGroups=kith
# The database, the ACME certificate cache and the one-time setup link.
StateDirectory=kith-console
StateDirectoryMode=0700
# Ports 80 and 443, nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
